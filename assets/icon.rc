// SoundShared / Bardwave — Win32 resources embedded in the executable.
//
// Compiled by `build.rs` (rc.exe) and linked into the binary, so the taskbar,
// Explorer, shortcuts and Alt-Tab all show the app mark instead of the default
// blank executable icon.
//
// Deliberately free of #include directives: rc.exe then needs no SDK include
// path, so the build stays self-contained wherever the Windows SDK is present.

// 1 = IDI_ICON1. Windows uses the first (lowest id) icon group for the file
// icon, so keep this id stable and low.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SoundShared\0"
            VALUE "FileDescription", "SoundShared - TTRPG ambience broadcast console\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "soundshared\0"
            VALUE "LegalCopyright", "MIT License\0"
            VALUE "OriginalFilename", "soundshared.exe\0"
            VALUE "ProductName", "SoundShared\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
